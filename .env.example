# Copy this file to .env and fill in real values.
# NEVER commit the real .env file - it holds your Telegram user-account
# credentials and bot token.

# ---------- Postgres ----------
POSTGRES_USER=animebot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=animebot
DATABASE_URL=postgres://animebot:change-me@postgres:5432/animebot?sslmode=disable

# ---------- Shared internal auth ----------
# Random long string. Required by the MTProto listener, scheduler and admin
# tooling to call the core API's internal-only routes. Generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=change-me-to-a-random-secret

# ---------- Core API ----------
API_PORT=8080
API_BASE_URL=http://api:8080

# ---------- Telegram Bot (BotFather) ----------
# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=123456:your-bot-token
BOT_USERNAME=YourAnimeBot

# ---------- Telegram MTProto userbot (my.telegram.org) ----------
# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=change-me
SESSION_NAME=/data/userbot.session

# Private channel the bot is admin of; the userbot forwards matched posts
# here, and the bot delivers files to users via copyMessage from here.
# Get this id by forwarding a message from the channel to @userinfobot,
# or from Telethon's client.get_entity(...) - it looks like -100xxxxxxxxxx.
STORAGE_CHANNEL_ID=-1000000000000

CHANNEL_REFRESH_SECONDS=60
AUTO_PUBLISH=true
TRANSLATE_ENABLED=true

# ---------- Scheduler ----------
# Public showcase channel the bot posts daily anime highlights to.
TARGET_CHANNEL_ID=-1000000000001
POST_CRON_SCHEDULE=0 9 * * *
POPULARITY_CRON_SCHEDULE=0 * * * *
POSTS_PER_RUN=3
